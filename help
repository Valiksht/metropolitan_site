# 1. Подтянуть новый образ для сервиса web
sudo docker compose -f docker-compose.production.yml pull web
# 2. Перезапустить контейнер web с новым образом
sudo docker compose -f docker-compose.production.yml up -d web
# 3. Проверить, что контейнер web запущен с новым образом
sudo docker compose -f docker-compose.production.yml ps web




