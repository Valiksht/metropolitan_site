Спасение базы данных:

mkdir -p /root/volume_backups
cd /root/volume_backups

sudo docker volume ls | grep pg_data

sudo docker volume ls | grep pg_data

sudo docker run --rm \
  -v kstovo_nne_pg_data:/data \
  -v "$(pwd)":/backup \
  alpine sh -c "cd /data && tar czf /backup/kstovo_nne_pg_data.tar.gz ."

sudo docker volume ls | grep static

sudo docker run --rm \
  -v kstovo_nne_static:/data \
  -v "$(pwd)":/backup \
  alpine sh -c "cd /data && tar czf /backup/kstovo_nne_static.tar.gz ."

sudo docker volume ls | grep media

sudo docker run --rm \
  -v kstovo_nne_media:/data \
  -v "$(pwd)":/backup \
  alpine sh -c "cd /data && tar czf /backup/kstovo_nne_media.tar.gz ."

